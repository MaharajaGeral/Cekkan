# Salin file ini jadi ".env" lalu isi. JANGAN commit ".env" ke GitHub.
# Aturan: tanpa tanda kutip, tanpa spasi di sekitar "=".

# --- Penyedia AI (standar OpenAI-compatible) ---
# Untuk pindah penyedia, cukup ganti 3 baris ini.
#
# Gemini (gratis, untuk testing):
#   LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
#   LLM_MODEL=gemini-flash-latest      (atau nama model Flash dari Google AI Studio)
# DeepSeek (berbayar, untuk final):
#   LLM_BASE_URL=https://api.deepseek.com
#   LLM_MODEL=                         (isi sesuai daftar di api-docs.deepseek.com)
LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
LLM_API_KEY=isi_api_key_kamu_di_sini
LLM_MODEL=gemini-flash-latest

# Ubah ke false hanya jika penyedia menolak mode JSON (error 400)
LLM_JSON_MODE=true

# Alamat frontend yang boleh memanggil backend (pisahkan dengan koma).
# Saat online, isi dengan alamat website kamu.
ALLOWED_ORIGINS=http://127.0.0.1:5500,http://localhost:5500

# Batas total pemeriksaan per hari untuk SEMUA pengguna (pelindung kuota gratis)
DAILY_LIMIT=300

PORT=3000